# Anthropic API key (https://console.anthropic.com/settings/keys)
CLAUDE_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Managed Agent ID — create once via client.beta.agents.create(...)
CLAUDE_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxx

# Managed Agent environment ID — create once via client.beta.environments.create(...)
CLAUDE_ENVIRONMENT_ID=env_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to 3000
# PORT=3000
